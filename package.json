{
  "name": "amendoas-adm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.server.json && node ./node_modules/typescript/bin/tsc -p tsconfig.web.json && node ./node_modules/vite/bin/vite.js build",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "db:init": "node --env-file-if-exists=.env dist/server/db/init.js",
    "db:pilot": "node --env-file-if-exists=.env dist/server/db/pilot.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 test/*.test.mjs"
  },
  "dependencies": {
    "cookie": "^1.1.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.4.0",
    "mariadb": "^3.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  }
}
